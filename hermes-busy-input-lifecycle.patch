@@ -0,0 +1,46 @@
+"""Processing hooks for inbound messages, including inputs absorbed by an active turn."""
+
+import logging
+
+from gateway.platforms.event import MessageEvent
+
+
+logger = logging.getLogger("gateway.platforms.base")
+
+
+async def start_absorbed_processing(adapter, event: MessageEvent) -> None:
+    if event._processing_deferred:
+        await adapter._run_processing_hook("on_processing_start", event)
+
+
+async def run_processing_hook(adapter, hook_name: str, event: MessageEvent, *args, **kwargs) -> None:
+    if hook_name == "on_processing_complete" and event._processing_deferred:
+        return
+    async with event._processing_lock:
+        await _run_locked_processing_hook(adapter, hook_name, event, *args, **kwargs)
+
+
+async def _run_locked_processing_hook(adapter, hook_name: str, event: MessageEvent, *args, **kwargs) -> None:
+    if hook_name == "on_processing_start":
+        if event._processing_started:
+            return
+        event._processing_started = True
+    hook = getattr(adapter, hook_name, None)
+    if callable(hook):
+        try:
+            await hook(event, *args, **kwargs)
+        except Exception:
+            logger.warning("[%s] %s hook failed", adapter.name, hook_name, exc_info=True)
+    if hook_name == "on_processing_complete":
+        event._processing_started = False
+        await finish_absorbed_processing(event, *args, **kwargs)
+
+
+async def finish_absorbed_processing(event: MessageEvent, outcome, *, followups=None) -> None:
+    for entry in list(event._processing_followups) if followups is None else followups:
+        intake_adapter, followup = entry
+        followup._processing_deferred = False
+        # Cancellation during the busy acknowledgement can precede its start hook.
+        await intake_adapter._run_processing_hook("on_processing_start", followup)
+        await intake_adapter._run_processing_hook("on_processing_complete", followup, outcome)
+        event._processing_followups.remove(entry)
