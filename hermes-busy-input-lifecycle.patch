@@ -0,0 +1,107 @@
+"""Absorbed messages keep hook ordering and their own response's delivery result."""
+
+import asyncio
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform
+from gateway.platforms.event import MessageEvent, ProcessingOutcome
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from gateway.turn_context import TurnContext
+from tests.gateway.test_absorbed_message_lifecycle import ActiveAgent, RecordingAdapter
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("cancel_during_start", [False, True])
+async def test_completion_waits_for_start_and_preserves_children_on_cancellation(cancel_during_start):
+    entered, release, parent_done = asyncio.Event(), asyncio.Event(), asyncio.Event()
+    order = []
+
+    class SlowStartAdapter(RecordingAdapter):
+        async def on_processing_start(self, event):
+            if event.message_id == "B":
+                entered.set()
+                await release.wait()
+                order.append("start B")
+            await super().on_processing_start(event)
+
+        async def on_processing_complete(self, event, outcome):
+            order.append(f"complete {event.message_id}")
+            if event.message_id == "A":
+                parent_done.set()
+            await super().on_processing_complete(event, outcome)
+
+    adapter = SlowStartAdapter()
+    opening = MessageEvent(text="first", message_id="A")
+    children = [MessageEvent(text="correction", message_id=mid) for mid in ("B", "C")]
+    for child in children:
+        child._processing_deferred = True
+        opening._processing_followups.append((adapter, child))
+    start_task = None
+    if not cancel_during_start:
+        start_task = asyncio.create_task(adapter._run_processing_hook("on_processing_start", children[0]))
+        await asyncio.wait_for(entered.wait(), 5)
+    completing = asyncio.create_task(adapter._run_processing_hook(
+        "on_processing_complete", opening, ProcessingOutcome.SUCCESS))
+    await asyncio.wait_for(entered.wait(), 5)
+    await asyncio.wait_for(parent_done.wait(), 5)
+    try:
+        if cancel_during_start:
+            completing.cancel()
+            await asyncio.gather(completing, return_exceptions=True)
+        else:
+            assert "complete B" not in order
+    finally:
+        release.set()
+        await asyncio.gather(completing, *([start_task] if start_task else []), return_exceptions=True)
+    if cancel_during_start:
+        await adapter._run_processing_hook("on_processing_complete", opening, ProcessingOutcome.CANCELLED)
+    else:
+        assert order.index("start B") < order.index("complete B")
+    assert [mid for mid, _ in adapter.completed if mid != "A"] == ["B", "C"]
+    assert all(not child._processing_deferred for child in children)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("delivered", [False, True, None])
+async def test_absorbed_completion_uses_first_response_before_queued_turn(delivered):
+    adapter = RecordingAdapter(delivery_ok=delivered)
+    runner = GatewayRunner(config=GatewayConfig())
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", chat_type="dm", user_id="7")
+    opening = MessageEvent(text="first", source=source, message_id="A")
+    incoming = MessageEvent(text="correction", source=source, message_id="B")
+    # Canonicalize through the real adapter to preserve its intake provenance.
+    key = adapter._event_session_key(incoming)
+    agent = ActiveAgent(accept=True)
+    turn = runner._session_state(key).turn
+    turn.event, turn.agent = opening, agent
+    runner._fold_into_running_turn(agent, key, incoming)
+    assert incoming._processing_deferred
+    ctx = TurnContext(source=source, session_key=key, event_message_id="B", inbound_message_id="B")
+    response = {"final_response": "first answer"}
+    if delivered is None:
+        entered = asyncio.Event()
+
+        async def blocked_send(*args, **kwargs):
+            entered.set()
+            await asyncio.Event().wait()
+
+        adapter.send = blocked_send
+        delivery = asyncio.create_task(runner._run_agent_deliver_first_response(
+            ctx, adapter, response, response, None))
+        await asyncio.wait_for(entered.wait(), 5)
+        delivery.cancel()
+        await asyncio.gather(delivery, return_exceptions=True)
+        assert adapter.completed == []
+        await adapter._run_processing_hook("on_processing_complete", opening, ProcessingOutcome.CANCELLED)
+        assert adapter.completed == [("A", ProcessingOutcome.CANCELLED), ("B", ProcessingOutcome.CANCELLED)]
+        return
+    await runner._run_agent_deliver_first_response(ctx, adapter, response, response, None)
+    expected = ProcessingOutcome.SUCCESS if delivered else ProcessingOutcome.FAILURE
+    assert adapter.completed == [("B", expected)]
+    # The next queued turn's opposite outcome must not overwrite the correction's receipt.
+    await adapter._run_processing_hook("on_processing_complete", opening,
+        ProcessingOutcome.FAILURE if delivered else ProcessingOutcome.SUCCESS)
+    assert adapter.completed.count(("B", expected)) == 1
diff --git a/tests/gateway/test_absorbed_message_lifecycle.py b/tests/gateway/test_absorbed_message_lifecycle.py
new file mode 100644
index 00000000000..ce905eaf540
--- /dev/null
+++ b/tests/gateway/test_absorbed_message_lifecycle.py
@@ -0,0 +1,129 @@
+"""Busy inputs consumed by a running agent must not be retried or lose completion."""
+
+import asyncio
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.platforms.event import MessageEvent, ProcessingOutcome
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+
+
+class RecordingAdapter(BasePlatformAdapter):
+    def __init__(self, delivery_ok=True):
+        super().__init__(PlatformConfig(enabled=True), Platform.TELEGRAM)
+        self.delivery_ok = delivery_ok
+        self.started, self.completed, self.sent = [], [], []
+
+    async def connect(self):
+        return True
+
+    async def disconnect(self):
+        pass
+
+    async def get_chat_info(self, chat_id):
+        return {"id": chat_id}
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.sent.append((content, reply_to))
+        return SendResult(success=self.delivery_ok, error="refused")
+
+    async def on_processing_start(self, event):
+        self.started.append(event.message_id)
+
+    async def on_processing_complete(self, event, outcome):
+        self.completed.append((event.message_id, outcome))
+
+
+class ActiveAgent:
+    _supports_active_turn_redirect = True
+
+    def __init__(self, accept):
+        self.accept, self.inputs = accept, []
+
+    def redirect(self, text):
+        if self.accept:
+            self.inputs.append(text)
+        return self.accept
+
+    steer = redirect
+
+    def interrupt(self, text):
+        pass
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["interrupt", "steer"])
+@pytest.mark.parametrize("terminal", ["delivered", "refused", "cancelled"])
+async def test_absorbed_inputs_finish_only_after_the_running_turn(mode, terminal, monkeypatch):
+    """Missing admission or completion leaves a durable connector retrying the same input."""
+    adapter = RecordingAdapter()
+    runner = GatewayRunner(config=GatewayConfig())
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    runner._busy_input_mode, runner._busy_text_mode = mode, "interrupt"
+    monkeypatch.setattr(runner, "_is_user_authorized_for_source", lambda source: True)
+    entered, release = asyncio.Event(), asyncio.Event()
+    agent = ActiveAgent(accept=True)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", chat_type="dm", user_id="7")
+    opening = MessageEvent(text="first request", source=source, message_id="A")
+    key = adapter._event_session_key(opening)
+
+    async def run(event):
+        turn = runner._session_state(key).turn
+        turn.event, turn.agent = event, agent
+        entered.set()
+        await release.wait()
+        return "final answer"
+
+    adapter.set_message_handler(run)
+    adapter.set_busy_session_handler(runner._handle_active_session_busy_message)
+    await adapter.handle_message(opening)
+    await asyncio.wait_for(entered.wait(), 5)
+    task = adapter._session_tasks[key]
+    try:
+        for message_id in ("B", "C"):
+            incoming = MessageEvent(text=f"correction {message_id}", source=source, message_id=message_id)
+            await adapter.handle_message(incoming)
+            assert incoming._gateway_accepted is True
+        assert len(agent.inputs) == 2
+        assert adapter.started == ["A", "B", "C"]
+        assert adapter.completed == []
+        assert adapter._pending_messages == {}
+    finally:
+        adapter.delivery_ok = terminal != "refused"
+        if terminal == "cancelled":
+            adapter._expected_cancelled_tasks.add(task)
+            task.cancel()
+        release.set()
+        await asyncio.wait_for(asyncio.gather(task, return_exceptions=True), 5)
+
+    outcome = {"delivered": ProcessingOutcome.SUCCESS, "refused": ProcessingOutcome.FAILURE,
+               "cancelled": ProcessingOutcome.CANCELLED}[terminal]
+    assert adapter.completed == [(message_id, outcome) for message_id in ("A", "B", "C")]
+    assert sum(content == "final answer" for content, _ in adapter.sent) == (terminal != "cancelled")
+    # Repeating completion cannot complete the absorbed messages twice.
+    await adapter._run_processing_hook("on_processing_complete", opening, outcome)
+    assert adapter.completed.count(("B", outcome)) == adapter.completed.count(("C", outcome)) == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["interrupt", "steer"])
+async def test_refused_injection_is_queued_without_claiming_execution(mode, monkeypatch):
+    adapter = RecordingAdapter()
+    runner = GatewayRunner(config=GatewayConfig())
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    runner._busy_input_mode, runner._busy_text_mode = mode, "interrupt"
+    monkeypatch.setattr(runner, "_is_user_authorized_for_source", lambda source: True)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="123", chat_type="dm", user_id="7")
+    incoming = MessageEvent(text="correction", source=source, message_id="B")
+    key = adapter._event_session_key(incoming)
+    runner._session_state(key).turn.agent = ActiveAgent(accept=False)
+    adapter._active_sessions[key] = asyncio.Event()
+    adapter.set_message_handler(lambda event: None)
+    adapter.set_busy_session_handler(runner._handle_active_session_busy_message)
+    await adapter.handle_message(incoming)
+    assert incoming._gateway_accepted is True
+    assert adapter._pending_messages[key] is incoming
+    assert adapter.started == adapter.completed == []
