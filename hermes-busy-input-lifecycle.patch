+async def deliver_absorbed_first_response(runner, *args, **kwargs) -> bool:
+    """Settle absorbed inputs with their response, before the queued turn replaces its outcome."""
+    from gateway.platforms.processing import finish_absorbed_processing
+
+    state = runner._peek_session_state(kwargs.get("session_key"))
+    opening = state.turn.event if state is not None else None
+    followups = list(opening._processing_followups) if opening is not None else []
+    delivered = False
+    cancelled = False
+    try:
+        delivered = await runner._deliver_queued_first_response(*args, **kwargs)
+        return delivered
+    except asyncio.CancelledError:
+        cancelled = True
+        raise
+    finally:
+        if opening is not None and not cancelled:
+            await finish_absorbed_processing(opening,
+                ProcessingOutcome.SUCCESS if delivered else ProcessingOutcome.FAILURE, followups=followups)
